# Copia este archivo a .env y ajusta tus datos de PostgreSQL local
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=mym_contratistas;Username=postgres;Password=TU_PASSWORD
# Clave secreta para firmar los JWT (mínimo 32 caracteres, aleatoria)
Jwt__Key=
Jwt__Issuer=MymContratistas.Api
Jwt__Audience=MymContratistas.Web
# Contraseña inicial de los usuarios de ejemplo (solo se usa si la tabla Usuarios está vacía)
Seed__Password=
